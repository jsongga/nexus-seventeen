{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "#shared/task-board-contract": ["src/shared/task-board-contract/index.ts"],
      "#shared/task-board-contract/*": ["src/shared/task-board-contract/*"],
      "#server/agents/task-fleet": ["src/server/agents/task-fleet/index.ts"],
      "#server/agents/task-fleet/*": ["src/server/agents/task-fleet/*"],
      "#server/agents/task-worker": ["src/server/agents/task-worker/index.ts"],
      "#server/agents/task-worker/*": ["src/server/agents/task-worker/*"],
      "#server/task-board": ["src/server/task-board/index.ts"],
      "#server/task-board/*": ["src/server/task-board/*"]
    },
    "rootDir": "src",
    "outDir": "build",
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/server/**/*.ts", "src/shared/**/*.ts"]
}
