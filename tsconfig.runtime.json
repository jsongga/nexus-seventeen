{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "#shared/model-routing": ["src/shared/model-routing/index.ts"],
      "#shared/model-routing/*": ["src/shared/model-routing/*"],
      "#shared/protocol": ["src/shared/protocol/index.ts"],
      "#shared/protocol/*": ["src/shared/protocol/*"],
      "#shared/role-policy": ["src/shared/role-policy/index.ts"],
      "#shared/role-policy/*": ["src/shared/role-policy/*"],
      "#shared/task-board-contract": ["src/shared/task-board-contract/index.ts"],
      "#shared/task-board-contract/*": ["src/shared/task-board-contract/*"],
      "#server/agents/cli-provider-adapter": ["src/server/agents/cli-provider-adapter/index.ts"],
      "#server/agents/cli-provider-adapter/*": ["src/server/agents/cli-provider-adapter/*"],
      "#server/agents/supervisor": ["src/server/agents/supervisor/index.ts"],
      "#server/agents/supervisor/*": ["src/server/agents/supervisor/*"],
      "#server/agents/task-fleet": ["src/server/agents/task-fleet/index.ts"],
      "#server/agents/task-fleet/*": ["src/server/agents/task-fleet/*"],
      "#server/agents/task-worker": ["src/server/agents/task-worker/index.ts"],
      "#server/agents/task-worker/*": ["src/server/agents/task-worker/*"],
      "#server/control-plane": ["src/server/control-plane/index.ts"],
      "#server/control-plane/*": ["src/server/control-plane/*"],
      "#server/review/deployment-broker": ["src/server/review/deployment-broker/index.ts"],
      "#server/review/deployment-broker/*": ["src/server/review/deployment-broker/*"],
      "#server/review/impact-observer": ["src/server/review/impact-observer/index.ts"],
      "#server/review/impact-observer/*": ["src/server/review/impact-observer/*"],
      "#server/review/manager-review": ["src/server/review/manager-review/index.ts"],
      "#server/review/manager-review/*": ["src/server/review/manager-review/*"],
      "#server/review/manager-runtime": ["src/server/review/manager-runtime/index.ts"],
      "#server/review/manager-runtime/*": ["src/server/review/manager-runtime/*"],
      "#server/task-board": ["src/server/task-board/index.ts"],
      "#server/task-board/*": ["src/server/task-board/*"]
    },
    "rootDir": "src",
    "outDir": "build",
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/server/**/*.ts", "src/shared/**/*.ts"]
}
