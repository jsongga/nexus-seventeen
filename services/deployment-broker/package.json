{
  "name": "@cicada/steward-deployment-broker",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Manager-handoff-gated, human-authorized, single-use production deployment grants for Steward",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/main.js"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "typescript": "^5.7.3"
  }
}
