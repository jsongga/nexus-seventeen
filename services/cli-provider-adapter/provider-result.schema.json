{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "journal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "testOutcome": {
      "type": ["string", "null"],
      "enum": ["passed", "failed", null]
    },
    "resultOverview": {
      "type": ["string", "null"],
      "maxLength": 2000
    }
  },
  "required": ["journal", "testOutcome", "resultOverview"]
}
