{
  "name": "@cicada/steward-model-routing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Auditable, cheap-first model routing policy for Steward",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22"
  }
}

