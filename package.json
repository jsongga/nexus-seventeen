{
  "name": "steward-agent-control-plane",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "type": "module",
  "engines": {
    "node": "^22.0.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:control-plane": "npm run start -w @cicada/steward-control-plane",
    "dev:supervisor": "npm run start -w @cicada/steward-supervisor",
    "dev:impact-observer": "npm run start -w @cicada/steward-impact-observer",
    "dev:manager-review": "npm run start -w @cicada/steward-manager-review",
    "dev:deployment-broker": "npm run start -w @cicada/steward-deployment-broker",
    "build": "npm run build:protocol && tsc -b && vite build",
    "build:web": "npm run build:protocol && tsc -b && vite build",
    "build:protocol": "npm run build -w @cicada/steward-protocol",
    "build:model-routing": "npm run build -w @cicada/steward-model-routing",
    "build:role-policy": "npm run build -w @cicada/steward-role-policy",
    "build:control-plane": "npm run build -w @cicada/steward-control-plane",
    "build:supervisor": "npm run build -w @cicada/steward-supervisor",
    "build:cli-provider-adapter": "npm run build -w @cicada/steward-cli-provider-adapter",
    "build:impact-observer": "npm run build -w @cicada/steward-impact-observer",
    "build:manager-review": "npm run build -w @cicada/steward-manager-review",
    "build:deployment-broker": "npm run build -w @cicada/steward-deployment-broker",
    "build:integration": "npm run build -w @cicada/steward-integration",
    "build:runtime": "npm run build:protocol && npm run build:model-routing && npm run build:role-policy && npm run build:control-plane && npm run build:supervisor && npm run build:cli-provider-adapter && npm run build:impact-observer && npm run build:manager-review && npm run build:deployment-broker && npm run build:integration",
    "build:all": "npm run build:runtime && npm run build:web",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run build:protocol && vitest run",
    "test:web": "npm run build:protocol && vitest run",
    "test:protocol": "npm run test -w @cicada/steward-protocol",
    "test:model-routing": "npm run test -w @cicada/steward-model-routing",
    "test:role-policy": "npm run test -w @cicada/steward-role-policy",
    "test:control-plane": "npm run test -w @cicada/steward-control-plane",
    "test:supervisor": "npm run test -w @cicada/steward-supervisor",
    "test:cli-provider-adapter": "npm run test -w @cicada/steward-cli-provider-adapter",
    "test:impact-observer": "npm run test -w @cicada/steward-impact-observer",
    "test:manager-review": "npm run test -w @cicada/steward-manager-review",
    "test:deployment-broker": "npm run test -w @cicada/steward-deployment-broker",
    "test:integration": "npm run build:runtime && npm run test -w @cicada/steward-integration",
    "test:runtime": "npm run test:protocol && npm run test:model-routing && npm run test:role-policy && npm run test:control-plane && npm run test:supervisor && npm run test:cli-provider-adapter && npm run test:impact-observer && npm run test:manager-review && npm run test:deployment-broker && npm run test:integration",
    "test:all": "npm run test:web && npm run test:runtime",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "npm run build:protocol && tsc -b --pretty false",
    "typecheck:runtime": "npm run build:runtime",
    "typecheck:all": "npm run typecheck && npm run typecheck:runtime"
  },
  "dependencies": {
    "@cicada/steward-protocol": "0.1.0",
    "@fontsource-variable/manrope": "^5.2.7",
    "@fontsource/dm-mono": "^5.2.7",
    "lucide-react": "^0.577.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.19.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "4.1.10"
  }
}
