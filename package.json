{
  "name": "nexus-seventeen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#shared/model-routing": "./build/shared/model-routing/index.js",
    "#shared/model-routing/*": "./build/shared/model-routing/*.js",
    "#shared/protocol": "./build/shared/protocol/index.js",
    "#shared/protocol/*": "./build/shared/protocol/*.js",
    "#shared/role-policy": "./build/shared/role-policy/index.js",
    "#shared/role-policy/*": "./build/shared/role-policy/*.js",
    "#shared/task-board-contract": "./build/shared/task-board-contract/index.js",
    "#shared/task-board-contract/*": "./build/shared/task-board-contract/*.js",
    "#server/agents/cli-provider-adapter": "./build/server/agents/cli-provider-adapter/index.js",
    "#server/agents/cli-provider-adapter/*": "./build/server/agents/cli-provider-adapter/*.js",
    "#server/agents/supervisor": "./build/server/agents/supervisor/index.js",
    "#server/agents/supervisor/*": "./build/server/agents/supervisor/*.js",
    "#server/agents/task-fleet": "./build/server/agents/task-fleet/index.js",
    "#server/agents/task-fleet/*": "./build/server/agents/task-fleet/*.js",
    "#server/agents/task-worker": "./build/server/agents/task-worker/index.js",
    "#server/agents/task-worker/*": "./build/server/agents/task-worker/*.js",
    "#server/control-plane": "./build/server/control-plane/index.js",
    "#server/control-plane/*": "./build/server/control-plane/*.js",
    "#server/review/deployment-broker": "./build/server/review/deployment-broker/index.js",
    "#server/review/deployment-broker/*": "./build/server/review/deployment-broker/*.js",
    "#server/review/impact-observer": "./build/server/review/impact-observer/index.js",
    "#server/review/impact-observer/*": "./build/server/review/impact-observer/*.js",
    "#server/review/manager-review": "./build/server/review/manager-review/index.js",
    "#server/review/manager-review/*": "./build/server/review/manager-review/*.js",
    "#server/review/manager-runtime": "./build/server/review/manager-runtime/index.js",
    "#server/review/manager-runtime/*": "./build/server/review/manager-runtime/*.js",
    "#server/task-board": "./build/server/task-board/index.js",
    "#server/task-board/*": "./build/server/task-board/*.js"
  },
  "engines": {
    "node": ">=22.13.0 <23 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:control-plane": "npm run build:runtime && node build/server/control-plane/main.js",
    "dev:supervisor": "npm run build:runtime && node build/server/agents/supervisor/main.js",
    "dev:impact-observer": "npm run build:runtime && node build/server/review/impact-observer/main.js",
    "dev:manager-review": "npm run build:runtime && node build/server/review/manager-review/main.js",
    "dev:manager-runtime": "npm run build:runtime && node build/server/review/manager-runtime/main.js",
    "dev:deployment-broker": "npm run build:runtime && node build/server/review/deployment-broker/main.js",
    "dev:task-board": "npm run build:runtime && node build/server/task-board/main.js",
    "dev:task-worker": "npm run build:runtime && node build/server/agents/task-worker/main.js",
    "dev:task-fleet": "npm run build:runtime && node build/server/agents/task-fleet/main.js",
    "build": "npm run build:all",
    "build:web": "npm run build:runtime && tsc -b && vite build",
    "build:runtime": "tsc -p tsconfig.runtime.json && cp src/server/agents/cli-provider-adapter/provider-result.schema.json build/server/agents/cli-provider-adapter/ && cp src/server/agents/task-worker/agent-result.schema.json build/server/agents/task-worker/",
    "build:all": "npm run build:web",
    "preview": "vite preview",
    "test": "npm run test:all",
    "test:web": "vitest run src/web",
    "test:runtime": "npm run build:runtime && tsc -p tsconfig.test.json && node --test \".test-dist/tests/**/*.test.js\"",
    "test:integration": "npm run build:runtime && tsc -p tsconfig.test.json && node --test \".test-dist/tests/server/integration/*.test.js\"",
    "test:all": "npm run test:web && npm run test:runtime",
    "test:e2e": "playwright test",
    "test:bootstrap": "node --test scripts/bootstrap-lib.test.mjs",
    "bootstrap:validate": "node scripts/reconcile-bootstrap.mjs --validate",
    "bootstrap:apply": "node scripts/reconcile-bootstrap.mjs --apply",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "typecheck:runtime": "tsc -p tsconfig.runtime.json --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck:runtime"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.7",
    "@fontsource/dm-mono": "^5.2.7",
    "lucide-react": "^0.577.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.19.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "4.1.10"
  }
}
