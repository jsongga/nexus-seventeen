{
	admin off
	auto_https off
}

:3000 {
	encode zstd gzip

	header {
		-Server
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Referrer-Policy "same-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	# This route proves both the public gateway and loopback-only board are ready.
	handle /health {
		reverse_proxy 127.0.0.1:4318 {
			header_up -Origin
		}
	}

	# Keep the operator's bearer token end-to-end. The gateway deliberately does
	# not add one, so an unauthenticated visitor cannot inherit human authority.
	handle_path /board-api/* {
		reverse_proxy 127.0.0.1:4318 {
			header_up -Origin
		}
	}

	handle {
		root * /srv/steward
		try_files {path} /index.html
		file_server
	}
}
