{
	admin off
	auto_https off
}

:3000 {
	encode zstd gzip

	header {
		-Server
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Referrer-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' https: wss:; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	# This route proves both the public gateway and loopback-only board are ready.
	handle /health {
		reverse_proxy 127.0.0.1:4318 {
			header_up -Origin
		}
	}

	# Traefik's sso-signin and sso-nexus forward-auth middlewares gate this edge
	# to nexus-operator or admin-full-access staff, so Caddy can safely inject the
	# operator token. Removing the sso-nexus forward-auth gate would let visitors
	# inherit human authority here and must be treated as a security boundary change.
	# The token is injected unconditionally. docker-compose.dokploy.yml declares it
	# as ${STEWARD_TASK_BOARD_HUMAN_TOKEN:?...}, so the container cannot start
	# without one -- there is no empty case to branch on. An earlier version
	# guarded that impossible state with an `expression` matcher on {env.*}; the
	# matcher did not evaluate, every request fell through to the fallback that
	# STRIPPED Authorization, and the board answered 401 to every call.
	# header_up replaces rather than appends, so a client cannot smuggle its own.
	handle_path /board-api/* {
		reverse_proxy 127.0.0.1:4318 {
			header_up -Origin
			header_up Authorization "Bearer {env.STEWARD_TASK_BOARD_HUMAN_TOKEN}"
		}
	}

	# Vite fingerprints everything under /assets/, so those files are immutable and
	# safe to cache forever. index.html must NOT be: it is the only thing that
	# names the current bundle, so a cached copy pins the browser to an old build
	# and every later deploy is invisible to that user. Without this, a stale
	# index.html kept serving a bundle from before an auth fix and made the fix
	# look ineffective.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
	header / Cache-Control "no-cache"

	handle {
		root * /srv/steward
		try_files {path} /index.html
		file_server
	}
}
